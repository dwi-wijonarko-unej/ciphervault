# CipherVault environment variables (development example)
# Copy this file to .env and adjust values as needed.

# App
APP_NAME="CipherVault API"
DEBUG=false

# Security / Auth
SECRET_KEY="change-this-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database
DATABASE_URL="sqlite:///./data/ciphervault.db"

# Storage
STORAGE_PATH="./data/storage"

# UHC
UHC_LOGISTIC_R=3.923
UHC_MODULUS=257
UHC_MATRIX_SIZE=8

# RSA
RSA_KEY_SIZE=2048
RSA_PRIVATE_KEY_PATH="./data/keys/private.pem"
RSA_PUBLIC_KEY_PATH="./data/keys/public.pem"

# Session / KDF
SESSION_KEY_BYTES=32
PBKDF2_ITERATIONS=100000

# Runtime
PYTHONUNBUFFERED=1

# Production hardening (Fase 5)
CIPHERVAULT_DOMAIN="ciphervault.example.com"
POSTGRES_PASSWORD="ganti-dengan-password-kuat"
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=60
UPLOAD_RATE_LIMIT=10
UPLOAD_RATE_WINDOW_SECONDS=3600

# Email transaksional (SMTP)
# Lokal/testing: jalankan MailHog eksplisit via
#   docker compose --profile dev up -d mailhog
# lalu buka UI di http://localhost:8025 (SMTP: localhost:1025).
# Production: isi dengan kredensial SMTP asli (mis. Brevo/Mailgun)
# dan JANGAN aktifkan profile dev.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_TLS=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@ciphervault.local"

# Backup otomatis
BACKUP_DIR="./data/backups"
BACKUP_RETENTION_DAYS=7

# Seeder: file kredensial akun default (chmod 600, jangan commit)
SEED_CREDENTIALS_FILE="./data/.seed-credentials"

# Billing / Midtrans (Fase 6, sandbox)
MIDTRANS_SERVER_KEY=""
MIDTRANS_SANDBOX=true
SNAP_EXPIRY_HOURS=24
PUBLIC_BASE_URL="http://43.156.234.238:3000"
# Simulasi gateway untuk uji alur bayar tanpa key (JANGAN aktif di prod)
MOCK_GATEWAY=false
