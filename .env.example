# CipherVault environment variables (development example)
# Copy this file to .env and adjust values as needed.

# App
APP_NAME="CipherVault API"
DEBUG=false

# Security / Auth
SECRET_KEY="change-this-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Database
DATABASE_URL="sqlite:///./data/ciphervault.db"

# Storage
STORAGE_PATH="./data/storage"

# UHC
UHC_LOGISTIC_R=3.923
UHC_MODULUS=257
UHC_MATRIX_SIZE=8

# RSA
RSA_KEY_SIZE=2048
RSA_PRIVATE_KEY_PATH="./data/keys/private.pem"
RSA_PUBLIC_KEY_PATH="./data/keys/public.pem"

# Session / KDF
SESSION_KEY_BYTES=32
PBKDF2_ITERATIONS=100000

# Runtime
PYTHONUNBUFFERED=1
